# nudge.env.example — copy to nudge.env (git-ignored) and set ONE backend.
#
# Leave everything unset to keep nudges as a safe no-op (they log instead of send).
#
# The message is available to any NUDGE_CMD as the env var $NUDGE_MESSAGE.

# --- Option A: iMessage (recommended on a Mac — Adam lives in iMessage, not Signal) ---
# Sends via Messages.app over AppleScript (schedule/imessage_nudge.sh). No extra daemon:
# Messages must be signed in (same account chat.db reads), and Terminal/your launcher needs
# Automation permission for Messages (granted once on first send). IMESSAGE_TO is the
# recipient handle — your own number/email for a self-nudge — and MUST be exported so the
# `sh -c "$NUDGE_CMD"` subshell inherits it.
# export IMESSAGE_TO='+447700900000'
# NUDGE_CMD='sh /ABSOLUTE/PATH/TO/schedule/imessage_nudge.sh "$NUDGE_MESSAGE"'

# --- Option B: a custom command (e.g. OpenClaw / Signal wrapper) ---
# Example (pseudo — point this at your real wrapper):
#   NUDGE_CMD='openclaw message send --channel signal --target <NUMBER> -m "$NUDGE_MESSAGE"'
# NUDGE_CMD=''

# --- Option C: signal-cli direct ---
# SIGNAL_FROM: the registered sending number (E.164, e.g. +447700900000)
# SIGNAL_TO:   the recipient — your own number for a self-nudge
# SIGNAL_FROM=''
# SIGNAL_TO=''
