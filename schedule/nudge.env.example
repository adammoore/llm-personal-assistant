# nudge.env.example — copy to nudge.env (git-ignored) and set ONE backend.
#
# Leave everything unset to keep nudges as a safe no-op (they log instead of send).

# --- Option A: a custom command (recommended — routes via OpenClaw / send_signal_alert) ---
# The message is available to the command as the env var $NUDGE_MESSAGE.
# Example (pseudo — point this at your real Signal wrapper):
#   NUDGE_CMD='openclaw signal send --to me "$NUDGE_MESSAGE"'
# NUDGE_CMD=''

# --- Option B: signal-cli direct ---
# SIGNAL_FROM: the registered sending number (E.164, e.g. +447700900000)
# SIGNAL_TO:   the recipient — your own number for a self-nudge
# SIGNAL_FROM=''
# SIGNAL_TO=''
