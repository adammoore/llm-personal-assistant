<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.adamvialsmoore.signal-cli-daemon.plist  (TEMPLATE — replace <YOUR_NUMBER>)
  ─────────────────────────────────────────────────────────────────────────────
  Keeps signal-cli running as a JSON-RPC HTTP daemon on 127.0.0.1:8080, which OpenClaw's
  Signal channel talks to for the PA's nudges + two-way loop. KeepAlive restarts it if it
  dies; RunAtLoad starts it at login.

  INSTALL:
    sed 's/<YOUR_NUMBER>/+441234567890/' \
      schedule/launchagents/com.adamvialsmoore.signal-cli-daemon.plist.example \
      > ~/Library/LaunchAgents/com.adamvialsmoore.signal-cli-daemon.plist
    launchctl load ~/Library/LaunchAgents/com.adamvialsmoore.signal-cli-daemon.plist

  (The real, number-filled plist lives only in ~/Library/LaunchAgents — not committed.)
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.adamvialsmoore.signal-cli-daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/signal-cli</string>
    <string>-a</string>
    <string>&lt;YOUR_NUMBER&gt;</string>
    <string>daemon</string>
    <string>--http</string>
    <string>127.0.0.1:8080</string>
    <string>--receive-mode</string>
    <string>on-connection</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/signal-cli-daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/signal-cli-daemon-error.log</string>
</dict>
</plist>
